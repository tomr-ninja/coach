#!/bin/sh
set -e

DATA_DIR="/data"
OUTPUT_DIR="/output"
mkdir -p "$DATA_DIR" "$OUTPUT_DIR"

echo "--- Phase 1: Fetching data and computing fingerprint ---"
FP=$(coach-artifact fetch --source "s3://${S3_PATH_IN}" --digest "$COACH_IMAGE_DIGEST" "$DATA_DIR")
S3_PATH_OUT="${S3_PATH_OUT_PREFIX}${FP}"
echo "Fingerprint: $FP"

echo "--- Phase 2: Running Application ---"
set +e
{{.RunCommand}}
APP_EXIT_CODE=$?

echo "--- Phase 3: Uploading output to S3 ---"
coach-artifact upload "$OUTPUT_DIR" "s3://${S3_PATH_OUT}"

exit $APP_EXIT_CODE
