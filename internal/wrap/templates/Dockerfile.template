# Stage 1: Build coach-artifact
FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/artifact/ internal/artifact/
COPY cmd/coach-artifact/ cmd/coach-artifact/
RUN CGO_ENABLED=0 GOOS={{.TargetOS}} GOARCH={{.TargetArch}} go build -o /coach-artifact ./cmd/coach-artifact/

# Stage 2: Wrapper image
FROM {{.BaseImage}}
COPY --from=builder /coach-artifact /usr/local/bin/coach-artifact
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
