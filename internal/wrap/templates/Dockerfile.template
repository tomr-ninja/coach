# Stage 1: Build coach-sidecar
# Builds natively, cross-compiles to target via GOOS/GOARCH.
FROM --platform={{.BuilderOS}}/{{.BuilderArch}} golang:1.26-alpine AS builder
ARG COACH_VERSION={{.CoachVersion}}
WORKDIR /build
RUN go mod init build && \
    go get github.com/tomr-ninja/coach/cmd/coach-sidecar@${COACH_VERSION}
RUN CGO_ENABLED=0 GOOS={{.TargetOS}} GOARCH={{.TargetArch}} \
    go build -o /coach-sidecar github.com/tomr-ninja/coach/cmd/coach-sidecar

# Stage 2: Wrapper image
FROM --platform={{.TargetOS}}/{{.TargetArch}} {{.BaseImage}}
COPY --from=builder /coach-sidecar /usr/local/bin/coach-sidecar
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
