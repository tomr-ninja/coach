#!/bin/sh
set -e

DATA_DIR="/data"
OUTPUT_DIR="/output"
mkdir -p "$DATA_DIR" "$OUTPUT_DIR"

echo "--- Phase 1: Syncing from S3 ($S3_PATH_IN) ---"
rclone copy "s3:$S3_PATH_IN" "$DATA_DIR" --verbose

echo "--- Phase 2: Running Application ---"
set +e
{{.RunCommand}}
APP_EXIT_CODE=$?

echo "--- Phase 3: Syncing to S3 ($S3_PATH_OUT) ---"
if ! rclone copy "$OUTPUT_DIR" "s3:$S3_PATH_OUT" --verbose; then
  echo "WARNING: S3 upload failed (exit code $?), but preserving application exit code $APP_EXIT_CODE" >&2
fi

exit $APP_EXIT_CODE
